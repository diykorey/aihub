DATABASE_URL=sqlite:///./aihub.db

# --- LLM -------------------------------------------------------------------
# Provider selector: openai | anthropic | gemini | grok
LLM_PROVIDER=openai

# Model name for the selected provider. Override per provider as needed.
LLM_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Gemini (either GEMINI_API_KEY or GOOGLE_API_KEY)
GEMINI_API_KEY=
GOOGLE_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# Grok / xAI (either XAI_API_KEY or GROK_API_KEY)
XAI_API_KEY=
GROK_API_KEY=
# GROK_BASE_URL=https://api.x.ai/v1

# Optional generic override for OpenAI-compatible providers
# LLM_BASE_URL=
